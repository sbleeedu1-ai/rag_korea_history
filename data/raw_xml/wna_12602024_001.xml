          <biblioData type="T">
            <title>
              <mainTitle>신경희가 권율의 행주 산성 대첩을 보고하자 인견하고 전투 상황을 상세히 묻다</mainTitle>
            </title>
            <docNo level="n" name="titleno">001</docNo>
            <date>
              <dateOccured date="1593-02-24L0" type="서기" />
            </date>
            <source>
              <mainTitle type="태백산사고본">宣祖實錄 18책 35권</mainTitle>
              <page begin="49장 A면" />
            </source>
            <source>
              <mainTitle type="국편영인본">宣祖實錄 21책</mainTitle>
              <page begin="645면" />
            </source>
            <subjectClass>외교-왜(倭)</subjectClass>
            <subjectClass>군사-전쟁(戰爭)</subjectClass>
          </biblioData>
