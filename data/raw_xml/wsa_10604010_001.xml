<level5 id="wsa_10604010_001">
        <front>
          <biblioData type="T">
            <title>
              <mainTitle>허적이 아들의 역모 사건과 관련하여 그 죄를 논하다</mainTitle>
            </title>
            <docNo level="n" name="titleno">001</docNo>
            <date>
              <dateOccured date="1680-04-10L0" type="서기" />
            </date>
            <source>
              <mainTitle type="태백산사고본">肅宗實錄 8책 9권</mainTitle>
              <page begin="18장 A면" />
            </source>
            <source>
              <mainTitle type="국편영인본">肅宗實錄 38책</mainTitle>
              <page begin="439면" />
            </source>
            <subjectClass>사법(司法)</subjectClass>
            <subjectClass>변란-정변(政變)</subjectClass>
            <subjectClass>왕실(王室)</subjectClass>
          </biblioData>
