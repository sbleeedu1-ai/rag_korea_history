<level5 id="wna_12506021_004">
        <front>
          <biblioData type="T">
            <title>
              <mainTitle>원균과 이순신이 한산도·당포에서 승전한 일에 대한 기록</mainTitle>
            </title>
            <docNo level="n" name="titleno">004</docNo>
            <date>
              <dateOccured date="1592-06-21L0" type="서기" />
            </date>
            <source>
              <mainTitle type="태백산사고본">宣祖實錄 13책 27권</mainTitle>
              <page begin="13장 B면" />
            </source>
            <source>
              <mainTitle type="국편영인본">宣祖實錄 21책</mainTitle>
              <page begin="502면" />
            </source>
            <subjectClass>외교-왜(倭)</subjectClass>
            <subjectClass>군사(軍事)</subjectClass>
          </biblioData>
