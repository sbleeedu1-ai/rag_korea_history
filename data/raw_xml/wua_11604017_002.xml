              <mainTitle type="태백산사고본">英祖實錄 37책 51권</mainTitle>
              <page begin="18장 B면" />
            </source>
            <source>
              <mainTitle type="국편영인본">英祖實錄 42책</mainTitle>
              <page begin="659면" />
            </source>
            <subjectClass>행정-지방행정(地方行政)</subjectClass>
