              <mainTitle type="태백산사고본">世祖實錄 15책 42권</mainTitle>
              <page begin="13장 B면" />
            </source>
            <source>
              <mainTitle type="국편영인본">世祖實錄 8책</mainTitle>
              <page begin="74면" />
            </source>
