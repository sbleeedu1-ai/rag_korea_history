            <title>
              <mainTitle>추국 죄인 우군칙 등이 복주되다</mainTitle>
            </title>
            <docNo level="n" name="titleno">002</docNo>
            <date>
              <dateOccured date="1812-05-05L0" type="서기" />
            </date>
            <source>
              <mainTitle type="태백산사고본">純祖實錄 15책 15권</mainTitle>
              <page begin="45장 A면" />
            </source>
            <source>
              <mainTitle type="국편영인본">純祖實錄 48책</mainTitle>
              <page begin="23면" />
            </source>
            <subjectClass>사법-행형(行刑)</subjectClass>
            <subjectClass>변란-민란(民亂)</subjectClass>
