            <title>
              <mainTitle>이인좌 등 적이 청주성을 함락시키다</mainTitle>
            </title>
            <docNo level="n" name="titleno">006</docNo>
            <date>
              <dateOccured date="1728-03-15L0" type="서기" />
            </date>
            <source>
              <mainTitle type="태백산사고본">英祖實錄 13책 16권</mainTitle>
              <page begin="7장 B면" />
            </source>
            <source>
              <mainTitle type="국편영인본">英祖實錄 42책</mainTitle>
