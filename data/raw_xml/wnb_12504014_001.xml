          <biblioData type="T">
            <title>
              <mainTitle>14일 왜적이 군사를 일으켜 부산진을 함락시켜 부사 정발과 송상현이 전사하다</mainTitle>
            </title>
            <docNo level="n" name="titleno">001</docNo>
            <date>
              <dateOccured date="1592-04-14L0" type="서기" />
            </date>
            <source>
              <mainTitle type="태백산사고본">宣祖修正實錄 6책 26권</mainTitle>
              <page begin="1장 B면" />
            </source>
            <source>
              <mainTitle type="국편영인본">宣祖修正實錄 25책</mainTitle>
              <page begin="611면" />
            </source>
            <subjectClass>외교-왜(倭)</subjectClass>
            <subjectClass>군사-전쟁(戰爭)</subjectClass>
