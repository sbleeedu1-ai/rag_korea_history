            <title>
              <mainTitle>명정문에 나아가 향유·향리 등에게 결전의 편리 여부를 순문하다</mainTitle>
            </title>
            <docNo level="n" name="titleno">001</docNo>
            <date>
              <dateOccured date="1751-06-17L0" type="서기" />
            </date>
            <source>
              <mainTitle type="태백산사고본">英祖實錄 54책 74권</mainTitle>
              <page begin="11장 A면" />
            </source>
            <source>
              <mainTitle type="국편영인본">英祖實錄 43책</mainTitle>
