              <mainTitle type="태백산사고본">端宗實錄 3책 8권</mainTitle>
              <page begin="5장 B면" />
            </source>
            <source>
              <mainTitle type="국편영인본">端宗實錄 6책</mainTitle>
              <page begin="623면" />
