<level5 id="wma_10209018_003">
        <front>
          <biblioData type="T">
            <title>
              <mainTitle>부제학 정언각이 양재역 벽에 붙은 익명서를 가져와 관련자의 처벌을 논의하다</mainTitle>
            </title>
            <docNo level="n" name="titleno">003</docNo>
            <date>
              <dateOccured date="1547-09-18L0" type="서기" />
            </date>
            <source>
              <mainTitle type="태백산사고본">明宗實錄 5책 6권</mainTitle>
              <page begin="20장 B면" />
            </source>
            <source>
              <mainTitle type="국편영인본">明宗實錄 19책</mainTitle>
              <page begin="528면" />
            </source>
            <subjectClass>왕실(王室)</subjectClass>
            <subjectClass>정론(政論)</subjectClass>
            <subjectClass>사법(司法)</subjectClass>
            <subjectClass>변란(變亂)</subjectClass>
            <subjectClass>역사-사학(史學)</subjectClass>
            <subjectClass>인물(人物)</subjectClass>
          </biblioData>
