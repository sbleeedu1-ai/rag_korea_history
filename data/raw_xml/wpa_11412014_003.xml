            <title>
              <mainTitle>최명길에게 강화를 청하게 하고 상은 남한 산성에 도착, 강도로 가기로 결정하다</mainTitle>
            </title>
            <docNo level="n" name="titleno">003</docNo>
            <date>
              <dateOccured date="1636-12-14L0" type="서기" />
            </date>
            <source>
              <mainTitle type="태백산사고본">仁祖實錄 33책 33권</mainTitle>
              <page begin="41장 A면" />
            </source>
            <source>
              <mainTitle type="국편영인본">仁祖實錄 34책</mainTitle>
              <page begin="657면" />
            </source>
            <subjectClass>왕실-행행(行幸)</subjectClass>
