<level5 id="wga_10206002_002">
        <front>
          <biblioData type="T">
            <title>
              <mainTitle>성균 사예 김질과 우찬성 정창손이 성삼문의 불궤를 고하다</mainTitle>
            </title>
            <docNo level="n" name="titleno">002</docNo>
            <date>
              <dateOccured date="1456-06-02L0" type="서기" />
            </date>
            <source>
              <mainTitle type="태백산사고본">世祖實錄 2책 4권</mainTitle>
              <page begin="10장 A면" />
            </source>
            <source>
              <mainTitle type="국편영인본">世祖實錄 7책</mainTitle>
              <page begin="134면" />
            </source>
            <subjectClass>변란-정변(政變)</subjectClass>
            <subjectClass>사법-재판(裁判)</subjectClass>
            <subjectClass>과학-천기(天氣)</subjectClass>
            <subjectClass>왕실(王室)</subjectClass>
          </biblioData>
