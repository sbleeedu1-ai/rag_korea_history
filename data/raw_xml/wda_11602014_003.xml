            <title>
              <mainTitle>함길도 감사 김종서가 경원·영북진의 성기와 그 포치의 조건들에 대하여 의견을 말하다</mainTitle>
            </title>
            <docNo level="n" name="titleno">003</docNo>
            <date>
              <dateOccured date="1434-02-14L0" type="서기" />
            </date>
            <source>
              <mainTitle type="태백산사고본">世宗實錄 20책 63권</mainTitle>
              <page begin="18장 A면" />
            </source>
            <source>
              <mainTitle type="국편영인본">世宗實錄 3책</mainTitle>
              <page begin="543면" />
            </source>
            <subjectClass>군사-관방(關防)</subjectClass>
            <subjectClass>군사-군정(軍政)</subjectClass>
            <subjectClass>행정-지방행정(地方行政)</subjectClass>
            <subjectClass>호구-이동(移動)</subjectClass>
            <subjectClass>농업-개간(開墾)</subjectClass>
