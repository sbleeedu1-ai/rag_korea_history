            <title>
              <mainTitle>대사헌 조광조·대사간 이성동이 합사로 정국 공신에 대해 아뢰다</mainTitle>
            </title>
            <docNo level="n" name="titleno">002</docNo>
            <date>
              <dateOccured date="1519-10-25L0" type="서기" />
            </date>
            <source>
              <mainTitle type="태백산사고본">中宗實錄 19책 37권</mainTitle>
              <page begin="6장 A면" />
            </source>
            <source>
              <mainTitle type="국편영인본">中宗實錄 15책</mainTitle>
              <page begin="574면" />
            </source>
            <subjectClass>정론-간쟁(諫諍)</subjectClass>
            <subjectClass>인사-관리(管理)</subjectClass>
            <subjectClass>인물(人物)</subjectClass>
