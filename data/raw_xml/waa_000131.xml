<level3 id="waa_000131">
      <front>
        <biblioData type="T">
          <title>
            <mainTitle>정몽주가 조준 등을 처형코자 하니, 태종이 정몽주를 죽이고 일당을 탄핵하다 </mainTitle>
          </title>
          <source>
            <mainTitle type="태백산사고본">太祖實錄 1책 1권</mainTitle>
            <page begin="34장 B면" />
          </source>
          <source>
            <mainTitle type="국편영인본">太祖實錄 1책</mainTitle>
            <page begin="17면" />
          </source>
          <subjectClass>인물(人物)</subjectClass>
          <subjectClass>왕실(王室)</subjectClass>
          <subjectClass>사법-행형(行刑)</subjectClass>
          <subjectClass>정론(政論)</subjectClass>
          <subjectClass>변란(變亂)</subjectClass>
          <subjectClass>역사(歷史)</subjectClass>
        </biblioData>
